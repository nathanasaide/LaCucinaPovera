---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  openText?: string;
  closedText?: string;
  scheduleOverride?: string;
}

const {
  title = 'La Cucina Povera',
  description = 'Focaccia sandwiches & Italian street food. Offerton, Stockport.',
  openText = 'Open today',
  closedText = 'Closed today',
  scheduleOverride = 'auto',
} = Astro.props;



const fullTitle = title === 'La Cucina Povera' ? title : `${title} · La Cucina Povera`;

// Load site settings for footer
const siteEntry = await getEntry('settings', 'site');
const site = siteEntry!.data;

// Resolve the base path for links
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="La Cucina Povera" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />

    <title>{fullTitle}</title>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <!-- Skip to main content -->
    <a href="#main" class="sr-only">Skip to content</a>

    <!-- Navigation -->
    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav__inner">
        <a href={`${base}/`} class="site-nav__logo" aria-label="La Cucina Povera — home">
          La Cucina Povera
        </a>

        <div class="site-nav__links">
          <a href={`${base}/`} class="nav-hide-sm">Home</a>
          <a href={`${base}/menu`}>Menu</a>
          <a href={`${base}/photos`} class="nav-hide-sm">Photos</a>
          <a href={`${base}/#find-us`}>Find us</a>
          <a
            href={`${base}/#find-us`}
            id="status-badge"
            class="status-badge status-badge--closed"
            aria-label={closedText}
            data-open-text={openText}
            data-closed-text={closedText}
            data-override={scheduleOverride}
            style="visibility:hidden"
          >
            <span class="status-badge__dot" aria-hidden="true"></span>
            <span id="status-badge-text">{closedText}</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Page content -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container container--wide">
        <div class="site-footer__grid">
          <div class="site-footer__col">
            <h3>La Cucina Povera</h3>
            <p>Focaccia sandwiches &amp;<br />Italian street food.</p>
          </div>

          <div class="site-footer__col">
            <h3>Opening hours</h3>
            {site.openingHours.map((row: { day: string; hours: string }) => (
              <p style={row.hours === 'Closed' ? 'opacity:0.4' : ''}>
                {row.day} — {row.hours}
              </p>
            ))}
            {site.hoursNote && (
              <p style="margin-top:0.75rem; font-size:0.8rem; color:var(--saffron); border-left:2px solid var(--saffron); padding-left:0.6rem; line-height:1.5;">
                {site.hoursNote}
              </p>
            )}
          </div>

          <div class="site-footer__col">
            <h3>Find us</h3>
            <p set:html={site.address.replace(/,\s*/g, ',<br />')}></p>
            <br />
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </div>

          <div class="site-footer__col">
            <h3>Say hello</h3>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <br /><br />
            <div class="site-footer__social">
              <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
              {site.facebookUrl && (
                <>
                  <span style="opacity:0.3">·</span>
                  <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
                </>
              )}
            </div>
          </div>
        </div>

        <div class="site-footer__bottom">
          <p>&copy; {new Date().getFullYear()} La Cucina Povera · 22 Park Lane · Offerton, Stockport</p>
          <div class="site-footer__social">
            <a href={`${base}/`}>Home</a>
            <a href={`${base}/menu`}>Menu</a>
            <a href={`${base}/photos`}>Photos</a>
            <a href={`${base}/#find-us`}>Find us</a>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }
    </style>

    <script>
      // Real-time open/closed status — runs in the browser on every page load.
      // Mirrors the logic in src/utils/openStatus.ts (kept in sync manually).

      const ANCHOR_FRIDAY = new Date('2025-10-10T00:00:00'); // Fri 10 Oct 2025 = open weekend anchor

      function fridayOf(date) {
        const d = new Date(date);
        const day = d.getDay();
        const daysToFriday = day === 0 ? -2 : day === 6 ? -1 : day - 5;
        d.setDate(d.getDate() + daysToFriday);
        d.setHours(0, 0, 0, 0);
        return d;
      }

      function isOpenWeekend(date) {
        const thisFriday = fridayOf(date);
        const anchor = new Date(ANCHOR_FRIDAY);
        anchor.setHours(0, 0, 0, 0);
        const weeksDiff = Math.round((thisFriday - anchor) / (7 * 24 * 60 * 60 * 1000));
        // Use ((n % 2) + 2) % 2 to handle negative weeksDiff correctly in JS
        return ((weeksDiff % 2) + 2) % 2 === 0;
      }

      function computeIsOpen(now, override) {
        if (override === 'open') return true;
        if (override === 'closed') return false;
        const day = now.getDay();
        const mins = now.getHours() * 60 + now.getMinutes();
        if (day === 3 || day === 4) return mins >= 1140 && mins < 1320; // Wed/Thu 19:00–22:00
        if (day === 5 || day === 6 || day === 0) {
          if (!isOpenWeekend(now)) return false;
          return mins >= 1020 && mins < 1320; // Fri/Sat/Sun 17:00–22:00
        }
        return false;
      }

      const badge = document.getElementById('status-badge');
      const badgeText = document.getElementById('status-badge-text');
      if (badge && badgeText) {
        const override = badge.dataset.override || 'auto';
        const openText = badge.dataset.openText || 'Open today';
        const closedText = badge.dataset.closedText || 'Closed today';
        const open = computeIsOpen(new Date(), override);
        badge.classList.toggle('status-badge--open', open);
        badge.classList.toggle('status-badge--closed', !open);
        badge.setAttribute('aria-label', open ? openText : closedText);
        badgeText.textContent = open ? openText : closedText;
        badge.style.visibility = 'visible';
      }
    </script>
  </body>
</html>
