---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  openText?: string;
  closedText?: string;
  scheduleOverride?: string;
}

const {
  title = 'La Cucina Povera',
  description = 'Focaccia sandwiches & Italian street food. Offerton, Stockport.',
  openText = 'Open now',
  closedText = 'Closed now',
  scheduleOverride = 'auto',
} = Astro.props;

const fullTitle = title === 'La Cucina Povera' ? title : `${title} · La Cucina Povera`;

const siteEntry = await getEntry('settings', 'site');
const site = siteEntry!.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="La Cucina Povera" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#main" class="sr-only skip-link">Skip to content</a>

    <!-- ── Top nav ──────────────────────────────────────── -->
    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav__inner">
        <!-- Brand -->
        <a href={`${base}/`} class="site-nav__logo" aria-label="La Cucina Povera — home">
          La Cucina<br />Povera
        </a>

        <!-- Desktop links -->
        <div class="site-nav__links">
          <a href={`${base}/`}>Home</a>
          <a href={`${base}/sandwiches`}>Sandwiches</a>
          <a href={`${base}/pizzas`}>Pizzas</a>
          <a href={`${base}/photos`}>Photos</a>
          <a href={`${base}/#find-us`}>Find us</a>
        </div>

        <!-- Desktop door sign -->
        <a
          href={`${base}/#find-us`}
          id="status-badge"
          class="status-badge status-badge--closed"
          aria-label={closedText}
          data-open-text={openText}
          data-closed-text={closedText}
          data-override={scheduleOverride}
          style="visibility:hidden; display:none;"
        >
          <small>Today</small>
          <span class="rstamp" id="status-badge-text">{closedText}</span>
        </a>

        <!-- Mobile: door sign + burger -->
        <div class="site-nav__mobile">
          <a
            href={`${base}/#find-us`}
            id="status-badge-mobile"
            class="status-badge status-badge--closed"
            aria-label={closedText}
            data-open-text={openText}
            data-closed-text={closedText}
            data-override={scheduleOverride}
            style="visibility:hidden"
          >
            <small>Today</small>
            <span class="rstamp" id="status-badge-text-mobile">{closedText}</span>
          </a>
          <button
            class="site-nav__burger"
            id="nav-burger"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>

      <!-- Mobile drawer -->
      <div class="site-nav__drawer" id="mobile-menu" aria-hidden="true">
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/sandwiches`}>Sandwiches</a>
        <a href={`${base}/pizzas`}>Pizzas</a>
        <a href={`${base}/photos`}>Photos</a>
        <a href={`${base}/#find-us`}>Find us</a>
      </div>
    </nav>

    <!-- ── Page content ──────────────────────────────────── -->
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <!-- ── Footer ───────────────────────────────────────── -->
    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div class="site-footer__col">
            <h3>La Cucina Povera</h3>
            <p>Focaccia &amp; Italian<br />street food.</p>
          </div>

          <div class="site-footer__col">
            <h3>Opening hours</h3>
            {site.openingHours.map((row: { day: string; hours: string }) => (
              <p style={row.hours === 'Closed' ? 'opacity:0.35' : ''}>
                {row.day} — {row.hours}
              </p>
            ))}
            {site.hoursNote && (
              <p
                data-hours-note-expires={site.hoursNoteExpires ?? ''}
                hidden={!!site.hoursNoteExpires}
                style="margin-top:0.6rem; font-size:0.8rem; color:var(--saffron); border-left:2px solid var(--saffron); padding-left:0.5rem; line-height:1.5;"
              >
                {site.hoursNote}
              </p>
            )}
          </div>

          <div class="site-footer__col">
            <h3>Find us</h3>
            <p set:html={site.address.replace(/,\s*/g, ',<br />')}></p>
            <br />
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </div>

          <div class="site-footer__col">
            <h3>Say hello</h3>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <br /><br />
            <div class="site-footer__social">
              <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
              {site.facebookUrl && (
                <>
                  <span style="opacity:0.3">·</span>
                  <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
                </>
              )}
            </div>
          </div>
        </div>

        <div class="site-footer__bottom">
          <p>&copy; {new Date().getFullYear()} La Cucina Povera · 22 Park Lane · Offerton, Stockport</p>
          <div class="site-footer__social">
            <a href={`${base}/`}>Home</a>
            <a href={`${base}/sandwiches`}>Sandwiches</a>
            <a href={`${base}/pizzas`}>Pizzas</a>
            <a href={`${base}/photos`}>Photos</a>
            <a href={`${base}/#find-us`}>Find us</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- ── Bottom dock (mobile) ──────────────────────────── -->
    <nav class="dock" aria-label="Quick actions">
      <a href={`${base}/sandwiches`}>
        <!-- Sandwich / bread icon -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 11h18M3 6c0-1.1 4-2 9-2s9 .9 9 2M3 11c0 5 2 7 9 7s9-2 9-7"/>
          <path d="M7 11v4M12 11v4M17 11v4"/>
        </svg>
        Sandwiches
      </a>
      <a href={`${base}/#find-us`}>
        <!-- Pin icon -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        Find us
      </a>
      <a href={`tel:${site.phone}`}>
        <!-- Phone icon -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call
      </a>
    </nav>

    <!-- ── Scripts ───────────────────────────────────────── -->
    <script>
      // Hamburger menu
      const burger = document.querySelector<HTMLButtonElement>('#nav-burger');
      const drawer = document.querySelector<HTMLElement>('#mobile-menu');
      const nav    = document.querySelector<HTMLElement>('.site-nav');
      const mq     = window.matchMedia('(max-width: 900px)');
      let prevOverflow = '';

      function closeMenu(restoreFocus = false) {
        if (!burger || !drawer || drawer.getAttribute('aria-hidden') === 'true') return;
        drawer.setAttribute('aria-hidden', 'true');
        burger.setAttribute('aria-expanded', 'false');
        burger.setAttribute('aria-label', 'Open menu');
        burger.classList.remove('is-open');
        document.body.style.overflow = prevOverflow;
        if (restoreFocus) burger.focus();
      }

      burger?.addEventListener('click', () => {
        if (!drawer || !mq.matches) return;
        if (drawer.getAttribute('aria-hidden') === 'false') {
          closeMenu(true);
        } else {
          prevOverflow = document.body.style.overflow;
          drawer.setAttribute('aria-hidden', 'false');
          burger.setAttribute('aria-expanded', 'true');
          burger.setAttribute('aria-label', 'Close menu');
          burger.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          drawer.querySelector<HTMLAnchorElement>('a')?.focus();
        }
      });
      drawer?.addEventListener('click', e => {
        if (e.target instanceof Element && e.target.closest('a')) closeMenu();
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && drawer?.getAttribute('aria-hidden') === 'false') {
          e.preventDefault(); closeMenu(true);
        }
      });
      document.addEventListener('focusin', e => {
        if (e.target instanceof Node && !nav?.contains(e.target)) closeMenu();
      });
      mq.addEventListener('change', () => {
        if (!mq.matches) {
          const inDrawer = drawer?.contains(document.activeElement);
          closeMenu();
          if (inDrawer) nav?.querySelector<HTMLAnchorElement>('.site-nav__logo')?.focus();
        }
      });
      document.addEventListener('click', e => {
        if (e.target instanceof Node && !nav?.contains(e.target)) closeMenu();
      });
    </script>

    <script>
      import { computeIsOpen, isHoursNoteCurrent } from '../utils/openStatus';

      // Show desktop badge on ≥900px only
      const desktopBadge = document.querySelector<HTMLElement>('#status-badge');
      if (desktopBadge && window.innerWidth >= 900) {
        desktopBadge.style.display = '';
      }

      function refreshStatus() {
        const now = new Date();
        document.querySelectorAll<HTMLElement>('[data-override]').forEach(badge => {
          const open = computeIsOpen(now, badge.dataset.override || 'auto');
          const text = open
            ? badge.dataset.openText  || 'Open now'
            : badge.dataset.closedText || 'Closed now';
          badge.classList.toggle('status-badge--open',   open);
          badge.classList.toggle('status-badge--closed', !open);
          badge.setAttribute('aria-label', text);
          const stamp = badge.querySelector<HTMLElement>('[id^="status-badge-text"]');
          if (stamp) stamp.textContent = text;
          badge.style.visibility = 'visible';
        });
        document.querySelectorAll<HTMLElement>('[data-hours-note-expires]').forEach(note => {
          note.hidden = !isHoursNoteCurrent(now, note.dataset.hoursNoteExpires);
        });
      }

      refreshStatus();
      window.setInterval(refreshStatus, 30_000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshStatus(); });
      window.addEventListener('pageshow', refreshStatus);
    </script>
  </body>
</html>
