---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.vue';

const site = await getEntry('settings', 'site');
const s = site!.data;

const photosEntry = await getEntry('photos', 'gallery');
const photos = photosEntry?.data.photos ?? [];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolvedPhotos = photos.map(p => ({
  ...p,
  src: p.src.startsWith('http') ? p.src : `${base}${p.src}`,
}));
---

<Layout
  title="Photos"
  description="Freshly baked — photos of the food and the good stuff. La Cucina Povera, Offerton, Stockport."
  openText={s.openStatusText}
  closedText={s.closedStatusText}
  scheduleOverride={s.scheduleOverride}
>
  <!-- Page header -->
  <div class="page-hero">
    <div class="wrap">
      <span class="label">Photos</span>
      <h1>Freshly<br /><span style="color:var(--rosso);">baked.</span></h1>
      <p class="lede" style="margin-top:0.875rem;">
        A few snaps of the day's bake and the good stuff.
        Pop in and see the real thing.
      </p>
    </div>
  </div>

  <!-- Gallery -->
  <section class="wrap block">
    {resolvedPhotos.length > 0 ? (
      <Gallery photos={resolvedPhotos} client:load />
    ) : (
      <div style="padding:3rem 0;">
        <p style="font-family:var(--font-typed); font-size:1rem; color:var(--nero-2); max-width:40ch;">
          Photos coming soon — have a nosy on Instagram in the meantime.
        </p>
        <a
          href={s.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-block; margin-top:1.25rem; font-family:var(--font-typed); font-weight:700; font-size:0.88rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--rosso);"
        >
          @la_cucinapovera on Instagram ↗
        </a>
      </div>
    )}
  </section>

  <!-- Swipe hint (mobile) -->
  <div style="padding:0.75rem 1rem 1.5rem; background:var(--carta);">
    <p style="font-family:var(--font-typed); font-size:0.75rem; color:var(--nero-3); text-transform:uppercase; letter-spacing:0.06em;">
      Swipe for more &nbsp;·&nbsp;
      <a href={s.instagramUrl} target="_blank" rel="noopener noreferrer" style="color:var(--rosso);">
        Have a nosy on Instagram · @la_cucinapovera
      </a>
    </p>
  </div>

  <!-- CTA -->
  <section style="background:var(--kraft); padding-block:2.25rem 3.25rem;">
    <div class="wrap" style="display:flex; flex-direction:column; gap:1rem;">
      <span class="label">Come in</span>
      <h2>See it in person.</h2>
      <p class="lede">It looks even better with a focaccia in hand.</p>
      <div class="btn-row">
        <a href={`${base}/#find-us`} class="btn btn--ink">Find us</a>
      </div>
    </div>
  </section>
</Layout>
