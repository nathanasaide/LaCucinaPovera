---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const site = await getEntry('settings', 'site');
const s = site!.data;

const woodbank = await getEntry('woodbank', 'site');
const w = woodbank!.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Pizzas"
  description="Wood-fired pizzas at Woodbank Park, Offerton. Made to order, come as you are. La Cucina Povera."
  openText={s.openStatusText}
  closedText={s.closedStatusText}
  scheduleOverride={s.scheduleOverride}
>
  <!-- Page header — dark, outdoor feel -->
  <div class="page-hero" style="background:var(--nero); color:var(--carta); border-bottom:2px solid var(--rosso);">
    <div class="wrap">
      <span class="label" style="color:rgba(255,255,255,0.5);">Woodbank Park</span>
      <h1>Come as you<br /><span style="color:var(--rosso);">are.</span></h1>
      <p class="lede" style="color:rgba(255,255,255,0.75); margin-top:0.875rem; max-width:36rem;">
        Wood-fired pizzas at Woodbank Park, Offerton. Made to order, out of a proper outdoor kitchen.
        Bring the dog. Come rain or shine.
      </p>
      <div class="btn-row" style="margin-top:1.25rem;">
        {w.googleMapsUrl && (
          <a href={w.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
            Get directions
          </a>
        )}
        <a href={`${base}/#find-us`} class="btn btn--ghost">Opening hours</a>
      </div>
    </div>
  </div>

  <!-- Intro -->
  <section class="wrap block">
    <div class="block__head">
      <span class="label">The setup</span>
      <h2>Pizza in<br /><span style="color:var(--rosso);">the park.</span></h2>
    </div>
    <p class="lede">
      La Cucina Povera at Woodbank Park is our outdoor kitchen — wood-fired pizzas made to order,
      out in the open. Whether you've got a lead in one hand or just a good appetite,
      you're welcome here.
    </p>
    <p class="lede">Everything is made fresh. Nothing is reheated.</p>
  </section>

  <!-- Pizza menu -->
  <section style="background:var(--kraft); padding-block:2.25rem 3.25rem;">
    <div class="wrap block" style="padding-block:0; gap:1.5rem;">
      <div class="block__head">
        <span class="label">The pizzas</span>
        <h2>From the<br /><span style="color:var(--rosso);">oven.</span></h2>
      </div>
      <p class="lede">
        Wood-fired, made to order. Each one built on a proper base —
        thin, charred at the edges, soft in the middle.
      </p>

      <div class="menu-sheet" style="max-width:640px;">
        {w.pizzas.map(pizza => (
          <article class="menu-item" style="grid-template-columns:1fr;">
            <div>
              <h3 class="menu-item__name">{pizza.name}</h3>
              <p class="menu-item__desc">{pizza.description}</p>
            </div>
          </article>
        ))}
      </div>

      <p style="font-family:var(--font-typed); font-size:0.8rem; color:var(--nero-3); border-top:1px dashed var(--piega); padding-top:1rem; max-width:640px;">
        Folded Neapolitan-style or boxed to take away — your call.
        Please ask about allergens before ordering.
      </p>
    </div>
  </section>

  <!-- Focaccia mention -->
  <section class="wrap block" style="gap:1rem;">
    <div class="block__head">
      <span class="label">Also at the park</span>
      <h2>Focaccia &amp;<br /><span style="color:var(--rosso);">soups.</span></h2>
    </div>
    {w.focacciaText.split('\n').filter(Boolean).map((para: string) => (
      <p class="lede">{para}</p>
    ))}
    {w.soupText.split('\n').filter(Boolean).map((para: string) => (
      <p class="lede">{para}</p>
    ))}
    <div class="btn-row" style="margin-top:0.5rem;">
      <a href={`${base}/sandwiches`} class="btn btn--line">See the sandwich menu</a>
    </div>
  </section>

  <!-- Find us at the park -->
  <section class="find-us">
    <div class="wrap block" style="gap:1.25rem;">
      <span class="label" style="color:rgba(255,255,255,0.5);">Where to find us</span>
      <h2>Woodbank<br /><span style="color:var(--rosso);">Park.</span></h2>
      <p style="font-family:var(--font-typed); font-size:0.94rem; color:rgba(255,255,255,0.7); max-width:40ch; line-height:1.7;">
        {w.locationText}
      </p>
      <div class="btn-row">
        {w.googleMapsUrl && (
          <a href={w.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
            Get directions
          </a>
        )}
        <a href={`${base}/#find-us`} class="btn btn--ghost">Opening hours</a>
        <a href={s.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
          Instagram
        </a>
      </div>
    </div>
  </section>
</Layout>
