---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const site = await getEntry('settings', 'site');
const s = site!.data;

const menuEntries = await getCollection('menu');
const focaccia = menuEntries.find(e => e.id === 'focaccia');
const allItems = focaccia ? focaccia.data.items : [];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="La Cucina Povera"
  description={s.tagline + ' ' + s.address}
  openText={s.openStatusText}
  closedText={s.closedStatusText}
  scheduleOverride={s.scheduleOverride}
>
  <!-- ======================================================
       HERO
       ====================================================== -->
  <section class="wrap hero">
    <!-- Text column -->
    <div class="hero__text">
      <h1>
        Hot<br />
        <span style="color:var(--rosso);">focaccia.</span>
      </h1>

      <p class="lede">
        Stuffed, wrapped in greaseproof and passed out the back of a converted outhouse
        in Offerton. Proper food, proper portions, dead good.
      </p>

      <!-- Quick-facts strip -->
      <ul class="facts">
        <li>
          <span>Wed &amp; Thu</span>
          <b>7pm – 10pm</b>
        </li>
        <li>
          <span>Open weekends</span>
          <b>Fri–Sun · 5pm – 10pm</b>
        </li>
        <li>
          <span>Round the back of</span>
          <b>{s.address}</b>
        </li>
      </ul>

      <div class="btn-row" style="margin-top:0.5rem;">
        <a href={`${base}/menu`} class="btn btn--ink">What's on the counter</a>
        <a href="#find-us" class="btn btn--line">Find us</a>
      </div>
    </div>

    <!-- Photo -->
    <div class="hero__media">
      <div class="hero__wrapped">
        <img
          src={`${base}/images/focaccia-loaves.jpg`}
          alt="Fresh-baked focaccia loaves cooling on a rack"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ======================================================
       STORY BAND
       ====================================================== -->
  <div class="story-band">
    <div class="wrap">
      <span class="label" style="color:rgba(255,255,255,0.6);">The idea</span>
      <h2>Cucina povera:<br />the poor kitchen.</h2>
      <div class="story-band__body">
        <p>
          Southern Italy's been making summat out of nowt for centuries: yesterday's bread,
          a few veg, a glug of good oil, and nothing wasted. Naples turned it into food
          you eat on the move — out of a hatch, off a counter, no fuss.
        </p>
        <p>
          We bake the focaccia in a converted outhouse round the back of a house in Offerton.
          It's not fancy. The food is. Stuff it with fillings worth your money, wrap it up,
          and it's still warm when you get home.
        </p>
      </div>
      <div class="btn-row">
        <a href={`${base}/menu`} class="btn btn--ghost">See the menu</a>
      </div>
    </div>
  </div>

  <!-- ======================================================
       MENU PREVIEW — "On the counter tonight"
       ====================================================== -->
  <section class="wrap block" id="menu-preview">
    <div class="block__head">
      <span class="label">Menu</span>
      <h2>On the counter<br /><span style="color:var(--rosso);">tonight.</span></h2>
    </div>

    <div class="menu-sheet" style="max-width:600px; padding-right:2rem;">
      {allItems.map(item => (
        <article class="menu-item">
          <div>
            <h3 class="menu-item__name">
              {item.name}
              {item.dietary === 'v' && <span class="menu-item__dietary">Veggie</span>}
              {item.dietary === 'vg' && <span class="menu-item__dietary vegan">Vegan</span>}
            </h3>
            <p class="menu-item__desc">{item.description}</p>
          </div>
          <div class="menu-item__price">{item.price}</div>
        </article>
      ))}
    </div>

    <p style="font-family:var(--font-typed); font-size:0.8rem; color:var(--nero-3);">
      Got allergies? Ask us before you order.
    </p>
  </section>

  <!-- ======================================================
       PHOTOS PREVIEW — "Freshly baked"
       ====================================================== -->
  <section style="background:var(--kraft); padding-block:2.25rem 3.25rem;">
    <div class="wrap block" style="padding-block:0; gap:1.25rem;">
      <div class="block__head">
        <span class="label">Photos</span>
        <h2>Freshly<br /><span style="color:var(--rosso);">baked.</span></h2>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; max-width:500px;">
        <div style="aspect-ratio:4/3; background:var(--piega); overflow:hidden;">
          <img
            src={`${base}/images/focaccia-loaves.jpg`}
            alt="The day's bake"
            loading="lazy"
            style="width:100%; height:100%; object-fit:cover;"
          />
        </div>
        <div style="aspect-ratio:4/3; background:var(--piega); display:flex; align-items:center; justify-content:center;">
          <span style="font-family:var(--font-typed); font-size:0.75rem; color:var(--nero-3); text-align:center; padding:0.5rem;">
            More photos<br />coming soon
          </span>
        </div>
      </div>

      <div>
        <a href={`${base}/photos`} class="btn btn--line" style="margin-right:0.75rem;">All photos</a>
        <a
          href={s.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="font-family:var(--font-typed); font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--nero-2);"
        >
          Have a nosy on Instagram · @la_cucinapovera
        </a>
      </div>
    </div>
  </section>

  <!-- ======================================================
       FIND US
       ====================================================== -->
  <section class="find-us" id="find-us">
    <div class="wrap block" style="gap:2rem;">
      <div class="block__head">
        <span class="label" style="color:rgba(255,255,255,0.5);">Find us</span>
        <h2>Round<br /><span style="color:var(--rosso);">the back.</span></h2>
      </div>

      <div class="find-us-grid">
        <!-- Hours -->
        <div>
          <table class="hours-table">
            {s.openingHours.map((row: { day: string; hours: string }) => (
              <tr class={row.hours === 'Closed' ? 'closed' : ''}>
                <td>{row.day}</td>
                <td>{row.hours}</td>
              </tr>
            ))}
          </table>

          {s.hoursNote && (
            <div
              class="hours-note"
              data-hours-note-expires={s.hoursNoteExpires ?? ''}
              hidden={!!s.hoursNoteExpires}
            >
              <p><strong>This week</strong>{s.hoursNote}</p>
            </div>
          )}
        </div>

        <!-- Contact -->
        <div>
          <p style="font-family:var(--font-stamp); font-size:clamp(1.25rem,4vw,1.75rem); text-transform:uppercase; color:var(--carta); line-height:1.3; margin-bottom:0.5rem;">
            Round the back of<br />22 Park Lane
          </p>
          <p style="font-family:var(--font-typed); font-size:0.85rem; color:rgba(255,255,255,0.45); margin-bottom:1.5rem;">
            Offerton, Stockport, SK1 4JS — follow the signs / smell the bread
          </p>

          <div class="contact-list">
            <a href={s.googleMapsUrl} target="_blank" rel="noopener noreferrer">
              <span>Directions</span>
              Get directions ↗
            </a>
            <a href={`tel:${s.phone}`}>
              <span>Call</span>
              {s.phone}
            </a>
            <a href={`mailto:${s.email}`}>
              <span>Email</span>
              {s.email}
            </a>
            <a href={s.instagramUrl} target="_blank" rel="noopener noreferrer">
              <span>Instagram</span>
              @la_cucinapovera
            </a>
          </div>
        </div>
      </div>

      <p style="font-family:var(--font-stamp); font-size:clamp(1.1rem,4vw,1.5rem); text-transform:uppercase; color:rgba(255,255,255,0.2); text-align:right; margin-top:1rem;">
        Mangia! Before it goes cold.
      </p>
    </div>
  </section>
</Layout>

<style>
.story-band__body {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  font-size: 1.06rem;
  max-width: 60ch;
  opacity: 0.9;
}
</style>
