---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const site = await getEntry('settings', 'site');
const s = site!.data;

const woodbank = await getEntry('woodbank', 'site');
const w = woodbank!.data;

const menuEntries = await getCollection('menu');
const focaccia = menuEntries.find(e => e.id === 'focaccia');
const sandwichItems = focaccia ? focaccia.data.items.slice(0, 3) : [];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="La Cucina Povera"
  description={s.tagline + ' ' + s.address}
  openText={s.openStatusText}
  closedText={s.closedStatusText}
  scheduleOverride={s.scheduleOverride}
>
  <!-- ======================================================
       HERO
       ====================================================== -->
  <section class="wrap hero">
    <div class="hero__text">
      <!-- Quiet entry — label + name, no giant red stamp -->
      <p class="hero-kicker">
        <span class="label">Offerton, Stockport</span>
      </p>
      <h1 class="hero-name">La Cucina<br />Povera</h1>
      <p class="hero-sub">
        Wood-fired pizza on the way to Woodbank Park, Offerton.<br />
        Made to order. Worth finding.
      </p>

      <ul class="facts">
        <li>
          <span>Open weekends</span>
          <b>Fri–Sun · 5pm – 10pm</b>
        </li>
        <li>
          <span>Also Wed &amp; Thu</span>
          <b>7pm – 10pm</b>
        </li>
        <li>
          <span>Find us</span>
          <b>22 Park Lane, Offerton</b>
        </li>
      </ul>

      <div class="btn-row" style="margin-top:0.5rem;">
        <a href={`${base}/pizzas`} class="btn btn--ink">Pizza menu</a>
        <a href="#find-us" class="btn btn--line">Find us</a>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__wrapped">
        <img
          src={`${base}/images/focaccia-loaves.jpg`}
          alt="Food from La Cucina Povera, Offerton"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ======================================================
       STORY BAND
       ====================================================== -->
  <div class="story-band">
    <div class="wrap">
      <span class="label" style="color:rgba(255,255,255,0.6);">The idea</span>
      <h2>Cucina povera:<br />the poor kitchen.</h2>
      <div class="story-band__body">
        <p>
          It's a thing people in the south of Italy have always done — take what you've got,
          a bit of dough, whatever's good, a proper fire — and make something worth eating.
          No ceremony. No waste. Food you eat standing up.
        </p>
        <p>
          This is that. A converted outhouse on Park Lane — on the way to Woodbank —
          and a proper outdoor kitchen out the back. Something we always wanted to do. Now we're doing it.
        </p>
        <p>
          Every pizza is made when you order it. Nothing sits. Nothing's reheated.
          You find us, we feed you. That's the deal.
        </p>
      </div>
      <div class="btn-row">
        <a href={`${base}/pizzas`} class="btn btn--ghost">Pizza menu</a>
        <a href={`${base}/sandwiches`} class="btn btn--ghost">Sandwiches</a>
      </div>
    </div>
  </div>

  <!-- ======================================================
       PIZZA PREVIEW
       ====================================================== -->
  <section class="wrap block" id="menu-preview">
    <div class="block__head">
      <span class="label">Woodbank Park</span>
      <h2>From the<br /><span style="color:var(--rosso);">oven.</span></h2>
      <p class="lede">Wood-fired, made to order. Thin base, charred edges, soft in the middle.</p>
    </div>

    <div class="menu-sheet" style="max-width:600px;">
      {w.pizzas.slice(0, 4).map((pizza, i) => {
        const twine = i % 2 === 0
          ? "M34 14 C28 10, 22 6, 14 9 C8 11, 6 16, 4 14"
          : "M34 14 C28 18, 22 22, 14 19 C8 17, 6 12, 4 14";
        const tagAngle = i % 2 === 0 ? "rotate(-2deg)" : "rotate(2deg)";
        return (
          <article class="menu-item">
            <div>
              <h3 class="menu-item__name">{pizza.name}</h3>
              <p class="menu-item__desc">{pizza.description}</p>
            </div>
            {pizza.price && (
              <div class="menu-item__price">
                <svg width="40" height="32" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                  <path d={twine} stroke="#8A6A42" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                  <circle cx="4" cy="14" r="3" stroke="#8A6A42" stroke-width="1.5" fill="#E9DDC6"/>
                </svg>
                <span class="price-tag" style={`transform:${tagAngle};`}>{pizza.price}</span>
              </div>
            )}
          </article>
        );
      })}
    </div>

    <div class="btn-row">
      <a href={`${base}/pizzas`} class="btn btn--line">Full pizza menu</a>
    </div>
  </section>

  <!-- ======================================================
       SANDWICHES — secondary, wholesale angle
       ====================================================== -->
  <section style="background:var(--kraft); padding-block:2.25rem 3.25rem;">
    <div class="wrap block" style="padding-block:0; gap:1.25rem;">
      <div class="block__head">
        <span class="label">Also on the counter</span>
        <h2>Focaccia<br /><span style="color:var(--rosso);">sandwiches.</span></h2>
        <p class="lede">
          Fresh-baked, stuffed properly, wrapped in greaseproof.
          Available from the outhouse at 22 Park Lane — and supplied to local coffee shops
          including Ranny's on Hempshaw Lane.
        </p>
      </div>

      <div class="menu-sheet" style="max-width:600px;">
        {sandwichItems.map((item, i) => {
          const twine = i % 2 === 0
            ? "M34 14 C28 10, 22 6, 14 9 C8 11, 6 16, 4 14"
            : "M34 14 C28 18, 22 22, 14 19 C8 17, 6 12, 4 14";
          const tagAngle = i % 2 === 0 ? "rotate(-2deg)" : "rotate(2deg)";
          return (
            <article class="menu-item">
              <div>
                <h3 class="menu-item__name">
                  {item.name}
                  {item.dietary === 'v'  && <span class="menu-item__dietary">Veggie</span>}
                  {item.dietary === 'vg' && <span class="menu-item__dietary vegan">Vegan</span>}
                </h3>
                <p class="menu-item__desc">{item.description}</p>
              </div>
              <div class="menu-item__price">
                <svg width="40" height="32" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                  <path d={twine} stroke="#8A6A42" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                  <circle cx="4" cy="14" r="3" stroke="#8A6A42" stroke-width="1.5" fill="#E9DDC6"/>
                </svg>
                <span class="price-tag" style={`transform:${tagAngle};`}>{item.price}</span>
              </div>
            </article>
          );
        })}
      </div>

      <div class="btn-row">
        <a href={`${base}/sandwiches`} class="btn btn--line">Full sandwich menu</a>
      </div>
    </div>
  </section>

  <!-- ======================================================
       PHOTOS PREVIEW
       ====================================================== -->
  <section style="padding-block:2.25rem 3.25rem;">
    <div class="wrap block" style="padding-block:0; gap:1.25rem;">
      <div class="block__head">
        <span class="label">Photos</span>
        <h2>Freshly<br /><span style="color:var(--rosso);">fired.</span></h2>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; max-width:500px;">
        <div style="aspect-ratio:4/3; background:var(--piega); overflow:hidden;">
          <img
            src={`${base}/images/focaccia-loaves.jpg`}
            alt="Food from La Cucina Povera"
            loading="lazy"
            style="width:100%; height:100%; object-fit:cover;"
          />
        </div>
        <div style="aspect-ratio:4/3; background:var(--piega); display:flex; align-items:center; justify-content:center;">
          <span style="font-family:var(--font-typed); font-size:0.75rem; color:var(--nero-3); text-align:center; padding:0.5rem;">
            More photos<br />coming soon
          </span>
        </div>
      </div>

      <div>
        <a href={`${base}/photos`} class="btn btn--line" style="margin-right:0.75rem;">All photos</a>
        <a
          href={s.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="font-family:var(--font-typed); font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--nero-2);"
        >
          Have a nosy on Instagram · @la_cucinapovera
        </a>
      </div>
    </div>
  </section>

  <!-- ======================================================
       FIND US
       ====================================================== -->
  <section class="find-us" id="find-us">
    <div class="wrap block" style="gap:2rem;">
      <div class="block__head">
        <span class="label" style="color:rgba(255,255,255,0.5);">Find us</span>
        <h2>Worth<br /><span style="color:var(--rosso);">finding.</span></h2>
      </div>

      <div class="find-us-grid">
        <div>
          <table class="hours-table">
            {s.openingHours.map((row: { day: string; hours: string }) => (
              <tr class={row.hours === 'Closed' ? 'closed' : ''}>
                <td>{row.day}</td>
                <td>{row.hours}</td>
              </tr>
            ))}
          </table>

          {s.hoursNote && (
            <div
              class="hours-note"
              data-hours-note-expires={s.hoursNoteExpires ?? ''}
              hidden={!!s.hoursNoteExpires}
            >
              <p><strong>This week</strong>{s.hoursNote}</p>
            </div>
          )}
        </div>

        <div>
          <p style="font-family:var(--font-stamp); font-size:clamp(1.25rem,4vw,1.75rem); text-transform:uppercase; color:var(--carta); line-height:1.3; margin-bottom:0.5rem;">
            Round the back of<br />22 Park Lane
          </p>
          <p style="font-family:var(--font-typed); font-size:0.85rem; color:rgba(255,255,255,0.45); margin-bottom:1.5rem;">
            Offerton, Stockport — not obvious from the outside. That's part of it.
          </p>

          <div class="contact-list">
            <a href={s.googleMapsUrl} target="_blank" rel="noopener noreferrer">
              <span>Directions</span>
              Get directions ↗
            </a>
            <a href={`tel:${s.phone}`}>
              <span>Call</span>
              {s.phone}
            </a>
            <a href={`mailto:${s.email}`}>
              <span>Email</span>
              {s.email}
            </a>
            <a href={s.instagramUrl} target="_blank" rel="noopener noreferrer">
              <span>Instagram</span>
              @la_cucinapovera
            </a>
          </div>
        </div>
      </div>

      <p style="font-family:var(--font-stamp); font-size:clamp(1.1rem,4vw,1.5rem); text-transform:uppercase; color:rgba(255,255,255,0.2); text-align:right; margin-top:1rem;">
        Mangia! Before it goes cold.
      </p>
    </div>
  </section>
</Layout>

<style>
.story-band__body {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  font-size: 1.06rem;
  max-width: 60ch;
  opacity: 0.9;
}
</style>
